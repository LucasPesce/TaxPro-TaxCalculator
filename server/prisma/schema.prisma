generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- MODELO DE VENTAS ---
model FacturaVenta {
  id                      Int    @id @default(autoincrement())
  
  // Datos internos de nuestro sistema
  cuitEmpresa             String // CUIT del cliente del estudio que hace la venta
  nombreEmpresa           String
  
  // Datos oficiales de AFIP
  fecha                   String // Fecha de Emisión
  tipoComprobante         String
  puntoVenta              String
  numeroDesde             String
  numeroHasta             String
  numeroFactura           String // Concatenado: 0005-00000001
  codAutorizacion         String
  tipoDocReceptor         String
  nroDocReceptor          String
  denominacionReceptor    String
  tipoCambio              Float  @default(1)
  moneda                  String @default("PES")
  
  // Importes
  netoGravado0            Float  @default(0)
  iva25                   Float  @default(0)
  netoGravado25           Float  @default(0)
  iva5                    Float  @default(0)
  netoGravado5            Float  @default(0)
  iva105                  Float  @default(0)
  netoGravado105          Float  @default(0)
  iva21                   Float  @default(0)
  netoGravado21           Float  @default(0)
  iva27                   Float  @default(0)
  netoGravado27           Float  @default(0)
  montoGravadoTotal       Float  @default(0)
  netoNoGravado           Float  @default(0)
  operacionesExentas      Float  @default(0)
  otrosTributos           Float  @default(0)
  totalIva                Float  @default(0)
  total                   Float  @default(0)
}

// --- MODELO DE COMPRAS ---
model FacturaCompra {
  id                  Int       @id @default(autoincrement())
  
  // Datos internos
  cuitEmpresa         String
  nombreEmpresa       String
  fechaImputacion     String    // Usada para el periodo de liquidación
  provincia           String    @default("Córdoba")
  jurisdiccion        String    @default("Córdoba")

  // Datos oficiales AFIP
  fechaEmision        String
  tipoComprobante     String
  puntoVenta          String
  numeroDesde         String
  numeroHasta         String
  numeroFactura       String    // Concatenado: 0007-00023449
  codAutorizacion     String
  tipoDocEmisor       String
  cuitProveedor       String    // Nro. Doc. Emisor (CUIT Proveedor)
  proveedor           String    // Denominación Emisor
  tipoCambio          Float     @default(1)
  moneda              String    @default("PES")
  
  // Importes
  montoGravado        Float     @default(0) // Imp. Neto Gravado
  netoNoGravado       Float     @default(0) // Imp. Neto No Gravado
  exento              Float     @default(0) // Imp. Op. Exentas
  otrosTributos       Float     @default(0) // Otros Tributos
  iva                 Float     @default(0) // IVA (Total)
  total               Float     @default(0) // Imp. Total

  activo              Boolean   @default(true)
  fechaEliminacion    DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// --- MODELO DE USUARIOS ---
model Usuario {
  id               Int       @id @default(autoincrement())
  documento        String    @unique
  nombre           String
  apellido         String
  username         String    @unique
  password         String 
  rol              String 
  activo           Boolean   @default(true) 
  fechaEliminacion DateTime? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MODELO DE AUDITORÍA GENERAL / ACTIVIDAD ---
model RegistroActividad {
  id               Int      @id @default(autoincrement())
  fechaHora        DateTime @default(now()) 
  
  operadorId       Int
  operadorDoc      String
  operadorNombre   String   
  
  accion           String   
  entidadAfectada  String   
  entidadId        Int      
  detalles         String?  

  datosAnteriores  String?  
  datosNuevos      String?  
}

// --- MODELO DE CLIENTES ---
model Cliente {
  id                  Int       @id @default(autoincrement())
  razonSocial         String
  cuitEmpresa         String    @unique
  cuitRepresentante   String
  claveFiscal         String     
  domicilio           String
  numero              String
  telefono            String
  email               String
  jurisdiccion        String
  condicionIva        String
  idActividad         String
  pyme                Boolean   @default(false)

  activo              Boolean   @default(true) 
  fechaEliminacion    DateTime? 

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// --- MODELO DE PROVEEDORES ---
model Proveedor {
  id               Int       @id @default(autoincrement())
  razonSocial      String
  cuitProveedor    String    @unique
  domicilio        String
  numero           String
  telefono         String
  email            String
  jurisdiccion     String
  condicionIva     String
  idActividad      String
  idTipoCompra     String    // Campo específico de proveedores
  
  activo           Boolean   @default(true) 
  fechaEliminacion DateTime? 

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}